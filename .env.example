# Copy to .env.local and fill in the values you have.
# .env.local is gitignored.

# OpenAI — needed to generate the image library (npm run images).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — defaults to 'gpt-image-1'. Set to override the image model.
# IMAGE_MODEL=gpt-image-1
