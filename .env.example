# Copy to .env.local and fill in the values you have.
# .env.local is gitignored.

# OpenAI — needed to generate the image library (npm run images).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — defaults to 'gpt-image-1'. Set to override the image model.
# IMAGE_MODEL=gpt-image-1

# Resend — transactional email for website form submissions.
# Get a key at https://resend.com/api-keys. The sending domain
# (smc.websitesubmission.com.au) must be verified in Resend.
RESEND_API_KEY=
# From address (must be on the verified Resend domain).
EMAIL_FROM=Steven M Clark Lawyers <enquiries@smc.websitesubmission.com.au>
# Where enquiry notifications land, and who is BCC'd.
EMAIL_TO=law@stevenmclark.com.au
EMAIL_BCC=alex@3pdigital.com.au
